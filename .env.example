# Copy to .env.local for local development. Never commit real values.
# Validated by src/lib/env/schema.ts. The site has no secrets.

# --- Public (inlined into the browser bundle) ---
# Canonical site URL, used for metadata, sitemap and Open Graph. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Umami Cloud website id (UUID). Leave empty to disable analytics locally.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
