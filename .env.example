# Copy to .env.local for local development. Never commit real values.
# Validated by src/lib/env/schema.ts.

# --- Public (inlined into the browser bundle, never put secrets here) ---
# Canonical site URL, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key. This is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Umami Cloud website id (UUID). Leave empty to disable analytics locally.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Server only (secrets, required in production) ---
# Cloudflare Turnstile secret. This is Cloudflare's always-pass test secret (also the
# default in development). Production builds refuse test keys.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Resend API key. If empty in development, contact emails are logged instead of sent.
RESEND_API_KEY=
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
# Sender address; must belong to a domain verified in Resend.
CONTACT_FROM_EMAIL=
# Upstash Redis (rate limiting, EU region). If empty in development, an in-memory
# limit is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string (>= 16 chars) used to hash visitor IPs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
