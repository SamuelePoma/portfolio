{
  "name": "samuelepoma-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio of Samuele Poma, software engineer.",
  "license": "MIT",
  "author": "Samuele Poma (https://github.com/SamuelePoma)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-hashes.mjs",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:html": "node scripts/validate-html.mjs",
    "size": "node scripts/bundle-size.mjs",
    "links": "linkinator http://localhost:3000 --config linkinator.config.json",
    "lighthouse": "lhci autorun",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm format:check && pnpm test",
    "prepare": "husky",
    "icons": "node scripts/generate-icons.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "licenses:write": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.1.0",
    "geist": "^1.9.2",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.36.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "html-validate": "^11.18.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.44.1",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.8.1"
}
